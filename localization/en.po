msgid "도시 타격 탄도미사일"
msgstr "City-Strike Ballistic Missile"

msgid "방공무장 타격 순항미사일"
msgstr "Defense-Strike Cruise Missile"

msgid "도시 타격 순항미사일"
msgstr "City-Strike Cruise Missile"

msgid "지원시설 타격 순항미사일"
msgstr "Support-Strike Cruise Missile"

msgid "기만 UAV"
msgstr "Decoy UAV"

msgid "전자전 UAV"
msgstr "Electronic-Warfare UAV"

msgid "방공무장 폭격 UAV"
msgstr "Defense-Bombing UAV"

msgid "지원시설 폭격 UAV"
msgstr "Support-Bombing UAV"

msgid "정찰 UAV"
msgstr "Reconnaissance UAV"

msgid "도시 타격 로켓"
msgstr "City-Strike Rocket"

msgid "방공무장 타격기"
msgstr "Defense-Strike Aircraft"

msgid "레이더 타격기"
msgstr "Radar-Strike Aircraft"

msgid "도시 타격기"
msgstr "City-Strike Aircraft"

msgid "레이더 포화 소형 UAV"
msgstr "Radar-Saturation Small UAV"

msgid "방공무장 자폭 소형 UAV"
msgstr "Defense-Strike Small UAV"

msgid "도시 자폭 소형 UAV"
msgstr "City-Strike Small UAV"

msgid "방공무장 포화 소형 UAV"
msgstr "Weapon-Saturation Small UAV"

# Placement and player feedback
msgid "우클릭 / Esc: 배치 취소"
msgstr "Right Click / Esc: Cancel Deployment"

msgid "우클릭 / Esc: 재배치 취소"
msgstr "Right Click / Esc: Cancel Relocation"

msgid "우클릭 / Esc: 위협 투입 취소"
msgstr "Right Click / Esc: Cancel Threat Launch"

msgid "배치 불가\n지도 위에서 위치를 선택하세요"
msgstr "CANNOT DEPLOY\nSelect a position on the map"

msgid "위협 투입 가능"
msgstr "Threat Launch Available"

msgid "배치 불가\n%s"
msgstr "CANNOT DEPLOY\n%s"

msgid "재배치 가능\n예상 소요 시간 %d초"
msgstr "RELOCATION AVAILABLE\nEstimated Time %ds"

msgid "재배치 시작"
