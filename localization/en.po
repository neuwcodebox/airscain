# Main menu and application shell
msgid "실시간 방공 전략 게임"
msgstr "REAL-TIME AIR DEFENSE STRATEGY"

msgid "새 게임"
msgstr "New Operation"

msgid "이어하기"
msgstr "Continue"

msgid "훈련"
msgstr "Training"

msgid "자유 모드"
msgstr "Sandbox"

msgid "종료"
msgstr "Quit"

msgid "방공 자산을 배치하고 도시를 방어합니다.\n시간이 지날수록 공격 규모가 커집니다."
msgstr "Deploy air-defense assets and protect the city.\nEnemy attacks grow over time."

msgid "저장한 게임을 불러옵니다."
msgstr "Load a saved operation."

msgid "자산 배치, 탐지, 교전, 보급 등 기본 조작을 익힙니다."
msgstr "Learn deployment, detection, engagement, and logistics."

msgid "방공 자산을 자유롭게 배치하고 위협을 직접 투입합니다."
msgstr "Deploy assets freely and launch threats manually."

msgid "사운드, 조작 감도와 화면 옵션을 조정합니다."
msgstr "Adjust audio, control sensitivity, and display options."

msgid "게임을 종료합니다."
msgstr "Exit the game."

msgid "전장 선택"
msgstr "Select Battlefield"

msgid "작전을 펼칠 전장의 큰 지형을 고르세요. 지형 방향과 해안선, 도시 배치는 작전마다 새로 만들어집니다."
msgstr "Choose the battlefield terrain. Its orientation, coastline, and city layout are regenerated for every operation."

msgid "뒤로"
msgstr "Back"

msgid "메인 메뉴로 돌아갑니다."
msgstr "Return to the main menu."

msgid "←  →  전장 선택      Enter  작전 시작      Esc  뒤로"
msgstr "←  →  SELECT      Enter  START OPERATION      Esc  BACK"

