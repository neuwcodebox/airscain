# Content names and descriptions
msgid "지휘통제소"
msgstr "Command Post"

msgid "센서 항적을 연결된 방어 자산에 전달합니다.\n센서와 방어 자산 양쪽에 C2 연결이 필요합니다."
msgstr "Relays sensor tracks to connected defense assets.\nBoth sensors and weapons require a C2 link."

msgid "근접방어기관포"
msgstr "Close-In Gun"

msgid "접근한 소형 무인기와 순항 위협을 탄막으로 방어합니다.\n탄약 소진 후 통합 지원기지에서 재보급할 수 있습니다."
msgstr "Engages nearby small UAVs and cruise threats with gunfire.\nA support base can replenish expended ammunition."

msgid "고출력 레이저"
msgstr "High-Energy Laser"

msgid "단일 표적을 과열 전까지 지속 조사합니다.\n탄약은 없지만 통합 지원기지의 전력 용량을 사용합니다."
msgstr "Continuously illuminates one target until overheating.\nUses support-base power capacity instead of ammunition."

msgid "고출력 마이크로파"
msgstr "High-Power Microwave"

msgid "조준점 주변의 여러 전자 표적을 한 번에 무력화합니다.\n단독·분산 표적에는 비효율적이며 전력 수요가 매우 높습니다."
msgstr "Disables multiple electronic targets around the aim point.\nInefficient against isolated targets and demands substantial power."

msgid "요격드론 기지"
msgstr "Interceptor Drone Base"

msgid "느린 무인기를 방어선 외곽에서 추적해 제거합니다.\n드론은 복귀 후 재사용하지만 고속·포화 표적에는 부적합합니다."
msgstr "Pursues slow UAVs beyond the defense perimeter.\nDrones return for reuse but are ill-suited to fast or saturated attacks."

msgid "일반 요격탄"
msgstr "Standard Interceptor"

msgid "고속 요격탄"
msgstr "High-Speed Interceptor"

msgid "표준 요격탄"
msgstr "Standard Interceptor"

msgid "근접 요격탄"
msgstr "Point-Defense Interceptor"

msgid "항공기·순항미사일"
msgstr "Aircraft · Cruise Missiles"

msgid "탄도미사일·로켓·고속 항공기"
msgstr "Ballistic Missiles · Rockets · High-Speed Aircraft"

msgid "장거리 미사일 포대"
msgstr "Long-Range Missile Battery"

msgid "고고도 항공기와 탄도 표적을 장거리에서 요격합니다.\nC2 지휘 경로를 통해 센서 항적을 공유받습니다."
msgstr "Intercepts high-altitude aircraft and ballistic targets at long range.\nReceives sensor tracks through the C2 network."

msgid "미사일 포대"
msgstr "Missile Battery"

msgid "중고도 항공 위협을 다수의 요격탄으로 방어합니다.\nC2 지휘 경로를 통해 센서 항적을 공유받습니다."
msgstr "Defends against medium-altitude air threats with multiple interceptors.\nReceives sensor tracks through the C2 network."

msgid "단거리 미사일 포대"
msgstr "Short-Range Missile Battery"

msgid "새어 들어온 저고도 표적에 한 발씩 빠르게 대응합니다.\n짧은 사거리와 4발 준비탄 때문에 포화 공격에는 취약합니다."
msgstr "Rapidly engages leaking low-altitude targets one round at a time.\nIts short range and four ready rounds make it vulnerable to saturation."

msgid "저·중고도 레이더"
msgstr "Low/Medium-Altitude Radar"

msgid "저고도와 중고도 항공 위협을 넓게 탐지합니다.\nC2 연결 시 탐지 항적을 방어 자산과 공유합니다."
msgstr "Detects low- and medium-altitude air threats over a wide area.\nShares tracks with defense assets through C2."

msgid "고고도 레이더"
msgstr "High-Altitude Radar"

msgid "고고도 항공기와 탄도 표적을 탐지합니다.\nC2 연결 시 탐지 항적을 방어 자산과 공유합니다."
msgstr "Detects high-altitude aircraft and ballistic targets.\nShares tracks with defense assets through C2."

msgid "통합 지원기지"
msgstr "Integrated Support Base"

msgid "근처 방공 자산을 재보급하고 수리합니다.\n에너지 무기에 전력을 공급합니다."
msgstr "Resupplies and repairs nearby air-defense assets.\nProvides power capacity for energy weapons."

msgid "도시"
msgstr "City"

msgid "조류 접촉"
msgstr "Bird Contact"

msgid "공대지 미사일"
msgstr "Air-to-Ground Missile"

msgid "레이더 타격 미사일"
