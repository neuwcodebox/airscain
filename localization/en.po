msgid "자동 재보급 켜짐"
msgstr "Automatic resupply enabled"

msgid "자동 재보급 꺼짐"
msgstr "Automatic resupply disabled"

msgid "수리 작업을 요청했습니다"
msgstr "Repair requested"

msgid "현재 수리를 요청할 수 없습니다"
