msgstr "작전 개시"

msgid "적 무인기 부대가 해상에서 도시 방향으로 출격했습니다. 레이더로 먼저 발견하고 지휘통제소를 거쳐 포대에 항적을 공유해야 요격할 수 있습니다."
msgstr "적 무인기 부대가 해상에서 도시 방향으로 출격했습니다. 레이더로 먼저 발견하고 지휘통제소를 거쳐 포대에 항적을 공유해야 요격할 수 있습니다."

msgid "접근 방향에 저·중고도 레이더를 두고, 미사일 포대와 기관포를 도시 앞에 겹쳐 배치하세요."
msgstr "접근 방향에 저·중고도 레이더를 두고, 미사일 포대와 기관포를 도시 앞에 겹쳐 배치하세요."

msgid "정찰과 군집"
msgstr "정찰과 군집"

msgid "적이 우리 방공망의 위치를 정찰하기 시작했습니다. 소형 무인기 군집과 기만 기체도 함께 투입될 것으로 보입니다."
msgstr "적이 우리 방공망의 위치를 정찰하기 시작했습니다. 소형 무인기 군집과 기만 기체도 함께 투입될 것으로 보입니다."

msgid "값싸게 반복 교전하는 기관포와 레이저로 군집을 처리하고, 미사일은 큰 표적에 아끼세요."
msgstr "값싸게 반복 교전하는 기관포와 레이저로 군집을 처리하고, 미사일은 큰 표적에 아끼세요."

msgid "순항미사일과 전자전"
msgstr "순항미사일과 전자전"

msgid "정찰로 드러난 레이더와 포대를 노리는 공격 준비가 포착됐습니다. 초저고도 순항미사일과 전자전 무인기도 등장합니다."
msgstr "정찰로 드러난 레이더와 포대를 노리는 공격 준비가 포착됐습니다. 초저고도 순항미사일과 전자전 무인기도 등장합니다."

msgid "단거리 포대로 새어 든 저고도 표적을 마무리하고, 요격드론으로 외곽의 느린 무인기를 먼저 제거하세요. 레이더 한 대에만 의존하지 마세요."
msgstr "단거리 포대로 새어 든 저고도 표적을 마무리하고, 요격드론으로 외곽의 느린 무인기를 먼저 제거하세요. 레이더 한 대에만 의존하지 마세요."

msgid "방공망 제압"
msgstr "방공망 제압"

msgid "적이 도시보다 방공망 자체를 먼저 무력화하려 합니다. 관측된 포대와 지원기지에 편대 공격이 집중될 것입니다."
msgstr "적이 도시보다 방공망 자체를 먼저 무력화하려 합니다. 관측된 포대와 지원기지에 편대 공격이 집중될 것입니다."

msgid "고출력 마이크로파로 밀집 편대를 한 번에 교란하고, 손상된 자산은 지원기지에서 빠르게 수리하세요. 자리를 옮기면 적의 관측이 낡습니다."
msgstr "고출력 마이크로파로 밀집 편대를 한 번에 교란하고, 손상된 자산은 지원기지에서 빠르게 수리하세요. 자리를 옮기면 적의 관측이 낡습니다."

msgid "고고도 타격"
msgstr "고고도 타격"

msgid "로켓 부대와 타격기가 합류했습니다. 저·중고도 레이더의 감시 한계 근처나 그 위에서 빠르게 접근합니다."
msgstr "로켓 부대와 타격기가 합류했습니다. 저·중고도 레이더의 감시 한계 근처나 그 위에서 빠르게 접근합니다."

msgid "고고도 레이더로 높은 표적을 일찍 발견하고, 타격기는 미사일을 쏘기 전에 격추하세요."
msgstr "고고도 레이더로 높은 표적을 일찍 발견하고, 타격기는 미사일을 쏘기 전에 격추하세요."

msgid "항공 타격과 포화"
msgstr "항공 타격과 포화"

msgid "고고도 도시 타격기와 12기 규모의 포화 군집이 확인됐습니다. 여러 방향과 고도에서 동시에 압박할 것입니다."
msgstr "고고도 도시 타격기와 12기 규모의 포화 군집이 확인됐습니다. 여러 방향과 고도에서 동시에 압박할 것입니다."

msgid "장거리 포대로 외곽의 항공기를 먼저 잡고, 근거리 계층은 군집 대응에 집중시키세요."
msgstr "장거리 포대로 외곽의 항공기를 먼저 잡고, 근거리 계층은 군집 대응에 집중시키세요."

msgid "탄도 위협"
msgstr "탄도 위협"

msgid "적이 탄도미사일 발사를 준비하고 있습니다. 먼 곳에서 높이 올라 급경사로 떨어지며 한 발의 피해가 큽니다."
msgstr "적이 탄도미사일 발사를 준비하고 있습니다. 먼 곳에서 높이 올라 급경사로 떨어지며 한 발의 피해가 큽니다."

msgid "고고도 레이더를 장거리 포대와 연결하고, 탄종을 자동 또는 고속 요격탄으로 두어 재진입 구간에서 요격하세요."
msgstr "고고도 레이더를 장거리 포대와 연결하고, 탄종을 자동 또는 고속 요격탄으로 두어 재진입 구간에서 요격하세요."

msgid "저고도로 느리게 접근해 도시 건물에 직접 충돌합니다."
msgstr "저고도로 느리게 접근해 도시 건물에 직접 충돌합니다."

msgid "작은 기체 여러 대가 함께 몰려와 교전 채널을 포화시킵니다."
msgstr "작은 기체 여러 대가 함께 몰려와 교전 채널을 포화시킵니다."

msgid "중고도에서 방공 자산을 찾아 이후 제압 공격에 위치를 넘깁니다."
msgstr "중고도에서 방공 자산을 찾아 이후 제압 공격에 위치를 넘깁니다."

msgid "실제 공격기와 구별하기 어려운 모습으로 요격탄을 끌어냅니다."
msgstr "실제 공격기와 구별하기 어려운 모습으로 요격탄을 끌어냅니다."

msgid "지형을 따라 초저고도로 빠르게 날아와 레이더에 늦게 잡힙니다."
msgstr "지형을 따라 초저고도로 빠르게 날아와 레이더에 늦게 잡힙니다."

msgid "보고된 레이더 주변을 선회하며 탐지와 지휘 연결을 방해합니다."
msgstr "보고된 레이더 주변을 선회하며 탐지와 지휘 연결을 방해합니다."

msgid "방사 중인 레이더를 추적해 빠르게 돌입합니다."
msgstr "방사 중인 레이더를 추적해 빠르게 돌입합니다."

msgid "관측된 방공무장에 직접 충돌해 기능을 정지시킵니다."
msgstr "관측된 방공무장에 직접 충돌해 기능을 정지시킵니다."

msgid "통합 지원기지에 폭탄을 떨어뜨려 보급과 전력을 끊습니다."
msgstr "통합 지원기지에 폭탄을 떨어뜨려 보급과 전력을 끊습니다."

msgid "관측된 포대를 근처에서 다시 확인한 뒤 폭탄을 투하하고 이탈합니다."
msgstr "관측된 포대를 근처에서 다시 확인한 뒤 폭탄을 투하하고 이탈합니다."

msgid "3기 편대가 방공무장 하나를 함께 노립니다."
msgstr "3기 편대가 방공무장 하나를 함께 노립니다."

msgid "지원시설을 향해 저고도로 날아오는 순항미사일입니다."
msgstr "지원시설을 향해 저고도로 날아오는 순항미사일입니다."

msgid "방공무장을 노리는 더 빠른 순항미사일입니다."
msgstr "방공무장을 노리는 더 빠른 순항미사일입니다."

msgid "높은 곡사 궤적으로 빠르게 떨어져 대응 시간이 짧습니다."
msgstr "높은 곡사 궤적으로 빠르게 떨어져 대응 시간이 짧습니다."

msgid "도시 외곽에서 레이더를 향해 공대지 미사일을 쏘고 이탈합니다."
msgstr "도시 외곽에서 레이더를 향해 공대지 미사일을 쏘고 이탈합니다."

msgid "저고도로 진입해 방공무장에 공대지 미사일을 발사합니다."
msgstr "저고도로 진입해 방공무장에 공대지 미사일을 발사합니다."

msgid "고고도에서 도시에 공대지 미사일을 발사합니다. 발사 전에 격추해야 합니다."
msgstr "고고도에서 도시에 공대지 미사일을 발사합니다. 발사 전에 격추해야 합니다."

msgid "12기 군집으로 방공무장 한 곳을 한꺼번에 덮칩니다."
msgstr "12기 군집으로 방공무장 한 곳을 한꺼번에 덮칩니다."

msgid "12기 군집으로 레이더를 덮쳐 방공망의 눈을 가립니다."
msgstr "12기 군집으로 레이더를 덮쳐 방공망의 눈을 가립니다."

msgid "고고도 중간비행 뒤 급경사로 재진입하며 한 발의 피해가 큽니다."
msgstr "고고도 중간비행 뒤 급경사로 재진입하며 한 발의 피해가 큽니다."

