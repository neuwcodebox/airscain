[sub_resource type="Shader" id="ChaffGlintShader"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never;

varying float shimmer_phase;

void vertex() {
	shimmer_phase = dot(MODEL_MATRIX[3].xyz, vec3(0.173, 0.317, 0.491));
}

void fragment() {
	float wave_a = sin(TIME * 11.0 + shimmer_phase);
	float wave_b = sin(TIME * 17.0 + shimmer_phase * 1.7);
	float flash = smoothstep(1.15, 1.8, wave_a + wave_b);
	vec3 glint_color = vec3(0.72, 0.88, 1.0);
	ALBEDO = glint_color;
	EMISSION = glint_color * 12.0;
	ALPHA = flash * COLOR.a;
}"

